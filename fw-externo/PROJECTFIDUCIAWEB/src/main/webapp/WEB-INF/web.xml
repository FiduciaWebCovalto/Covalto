<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

  <description>Empty web.xml file for Web Application</description>
  <session-config>
    <session-timeout>35</session-timeout>
  </session-config>
  <mime-mapping>
    <extension>html</extension>
    <mime-type>text/html</mime-type>
  </mime-mapping>
  <mime-mapping>
    <extension>txt</extension>
    <mime-type>text/plain</mime-type>
  </mime-mapping>
  <mime-mapping>
      <extension>css</extension>
      <mime-type>text/css</mime-type>
  </mime-mapping>
<context-param>
       <param-name>dirUploadFiles</param-name>
       <param-value>/imagenes</param-value>
   </context-param>
   <context-param>
       <param-name>maxFileSize</param-name>
       <param-value>307200</param-value>        
   </context-param>  

    <context-param>
        <param-name>apiBaseUrl</param-name>
        <param-value>http://localhost:8092</param-value>
    </context-param>
    <context-param>
        <param-name>apiBaseUrlOracle</param-name>
        <param-value>http://localhost:8091</param-value>
    </context-param>
  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

    <servlet>
        <servlet-name>ProcesarServlet</servlet-name>
        <servlet-class>mx.com.inscitech.clients.lib.ProcesarServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProcesarServlet</servlet-name>
        <url-pattern>/procesarDatos</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PdfServlet</servlet-name>
        <servlet-class>mx.com.inscitech.clients.lib.PdfServlet</servlet-class>
        
        <!-- Configuración para recibir archivos -->
        <multipart-config>
            <!-- Ubicación temporal donde se guardan los archivos -->
            <location>/tmp</location>
            <!-- Tamaño máximo por archivo (ej. 5MB) -->
            <max-file-size>5242880</max-file-size>
            <!-- Tamaño máximo de la solicitud (ej. 10MB) -->
            <max-request-size>10485760</max-request-size>
            <!-- Tamaño después del cual se escribe en disco -->
            <file-size-threshold>1048576</file-size-threshold>
        </multipart-config>
    </servlet>

    <servlet-mapping>
        <servlet-name>PdfServlet</servlet-name>
        <url-pattern>/uploadServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>OracleProxyServlet</servlet-name>
        <servlet-class>mx.com.inscitech.clients.util.OracleProxyServlet</servlet-class>
        <async-supported>true</async-supported>
    </servlet>
    <servlet-mapping>
        <servlet-name>OracleProxyServlet</servlet-name>
        <url-pattern>/orcl/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>OracleProxyServlet</servlet-name>
        <url-pattern>/api/orcl/*</url-pattern>
    </servlet-mapping>


  <security-constraint>
    <web-resource-collection>
      <web-resource-name>FiduciaWebMovil</web-resource-name>
      <description>Sitio accessible solo para usuarios auorizados</description>
      <url-pattern>/FiduciaWebMovil/*</url-pattern>
      <http-method>GET</http-method>
    </web-resource-collection>
    <user-data-constraint>
      <description>Es como se deben transitir los datos del usuario.</description>
      <transport-guarantee>NONE</transport-guarantee>
    </user-data-constraint>
  </security-constraint>

  <login-config>
    <auth-method>FORM</auth-method>
    <form-login-config>
      <form-login-page>/login.jsp</form-login-page>
      <form-error-page>/fail_login.html</form-error-page>
    </form-login-config>
  </login-config>


  
</web-app>
