<jsp:useBean id="FechaHabilSig"  class="com.bancomext.negocio.RetirosDB"/>
<%
//**************************************************************Seguridad*******************************************************/
   if (session.getValue("NumUser")==null )
	   {
	   session.putValue("Error","Por razones de seguridad tu sesión ha finalizado<br>por exceder el tiempo máximo de inactividad.<br> Por favor inicia de nuevo"); 
