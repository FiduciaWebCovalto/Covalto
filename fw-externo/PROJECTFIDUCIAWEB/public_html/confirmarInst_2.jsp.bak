            src="imagenes/logo.gif" 
            alt="<%=session.getAttribute("empresa_9")%>"   border="0"  width="204" height="65"></TD>
      <TD vAlign="top" background="imagenes/msur01.jpg"
          ></TD>
    </TR>
    <TR > 
      <TD colspan="2" align="center" height="1"></TD>
    </TR>
