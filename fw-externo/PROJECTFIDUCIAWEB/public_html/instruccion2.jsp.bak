            <% if(request.getParameter("cboCuentaSpeuaR")!=null)
                  out.print(request.getParameter("cboCuentaSpeuaR").substring((request.getParameter("cboCuentaSpeuaR")).indexOf('|')+2,(request.getParameter("cboCuentaSpeuaR")).length()));
						%>
