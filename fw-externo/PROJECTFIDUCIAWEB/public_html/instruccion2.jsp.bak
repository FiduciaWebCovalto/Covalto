              <%if(request.getParameter("txtConvenioCie")!=null)
      out.print(request.getParameter("txtConvenioCie"));%>
            </td>
          </tr>
        
        <%}%>
        
        <%
//<!------------------------------------- MODIFICADO POR CUBO OCT-07--------------------------------------------------->
