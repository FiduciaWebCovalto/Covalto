                  out.print(request.getParameter("txtBeneficiarioChequeR"));%>
          </td>
        </tr>
        <%}%>
        <%	
     		if((request.getParameter("cboFormaR")).equals("24")&&request.getParameter("cboFormaR")!=null && request.getParameter("pagosM")==null) 
						{%>
        <tr bordercolor="#000000"  bgcolor="#FFFFFF"> 
          <td  class=texto width="22%">Numero de Referencia CIE:</td>
