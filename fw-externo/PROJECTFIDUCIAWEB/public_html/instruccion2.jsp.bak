        </tr>
        <% }

		// SE INCORPORA LA FORMA DE LIQUIDACION SPEI LA CUAL SUSTITUYE SPEUA Y FUNCIONA COMO TEF

		if( ((request.getParameter("cboFormaR")).equals("20") || (request.getParameter("cboFormaR")).equals("3") )&& request.getParameter("cboFormaR")!=null  && request.getParameter("pagosM")==null) 
						{%>
