meta {
  name: POST - /bitacora
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/bitacora
  body: json
  auth: none
}

headers {
  Origin: {{frontendOrigin}}
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "bitDetBitacora": "Registro de prueba en bitacora",
  "bitAnoAltaReg": 2026,
  "bitMesAltaReg": 10,
  "bitDiaAltaReg": 5
}
}

assert {
  res.status: neq 401
  res.status: neq 403
}
