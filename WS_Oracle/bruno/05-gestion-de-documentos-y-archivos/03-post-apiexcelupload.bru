meta {
  name: POST - /api/excel/upload
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/excel/upload
  body: json
  auth: none
}

headers {
  Origin: {{frontendOrigin}}
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "id": 1,
  "descripcion": "Prueba"
}
}

assert {
  res.status: neq 401
  res.status: neq 403
}
