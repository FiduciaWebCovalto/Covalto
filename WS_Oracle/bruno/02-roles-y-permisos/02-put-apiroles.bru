meta {
  name: PUT - /api/roles
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/roles
  body: json
  auth: none
}

headers {
  Origin: {{frontendOrigin}}
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "name": "ROLE_TESTER"
}
}

assert {
  res.status: neq 401
  res.status: neq 403
}
