meta {
  name: POST - /api/auth/forgot-password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/forgot-password
  body: json
  auth: none
}

headers {
  Origin: {{frontendOrigin}}
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "email": "user@covalto.com",
  "code": "123456",
  "newPassword": "NewPassword123!"
}
}

assert {
  res.status: neq 401
  res.status: neq 403
}
