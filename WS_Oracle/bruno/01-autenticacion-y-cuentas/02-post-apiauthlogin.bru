meta {
  name: POST - /api/auth/login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Origin: {{frontendOrigin}}
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "email": "admin@covalto.com",
  "password": "Password123!"
}
}

assert {
  res.status: neq 401
  res.status: neq 403
}
