meta {
  name: POST - /api/auth/register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Origin: {{frontendOrigin}}
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "usuNomUsuario": "Juan Perez",
  "usuEmail": "juan.perez@covalto.com",
  "password": "Password123!",
  "usuNomPuesto": "Administrador",
  "roles": [
    "ADMIN"
  ]
}
}

assert {
  res.status: neq 401
  res.status: neq 403
}
