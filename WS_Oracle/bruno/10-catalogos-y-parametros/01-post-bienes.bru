meta {
  name: POST - /bienes
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/bienes
  body: json
  auth: none
}

headers {
  Origin: {{frontendOrigin}}
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "convValor": "Valor de bien inmueble"
}
}

assert {
  res.status: neq 401
  res.status: neq 403
}
