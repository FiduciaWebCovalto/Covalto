meta {
  name: POST - /api/reportes
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/reportes
  body: json
  auth: none
}

headers {
  Origin: {{frontendOrigin}}
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "nombre": "Reporte de Prueba",
  "descripcion": "Reporte generado para pruebas funcionales",
  "queryBase": "SELECT * FROM CAT_REPORTES"
}
}

assert {
  res.status: neq 401
  res.status: neq 403
}
