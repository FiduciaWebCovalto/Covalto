meta {
  name: OPTIONS - Preflight CORS Reportes (/api/reportes)
  type: http
  seq: 3
}

options {
  url: {{baseUrl}}/api/reportes
  body: none
  auth: none
}

headers {
  Origin: {{frontendOrigin}}
  Access-Control-Request-Method: PUT
  Access-Control-Request-Headers: content-type
}

assert {
  res.status: in [200, 204]
  res.headers["access-control-allow-origin"]: in ["{{frontendOrigin}}", "*"]
  res.headers["access-control-allow-credentials"]: eq "true"
}
