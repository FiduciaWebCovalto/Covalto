meta {
  name: OPTIONS - Preflight CORS Roles (/api/roles)
  type: http
  seq: 1
}

options {
  url: {{baseUrl}}/api/roles
  body: none
  auth: none
}

headers {
  Origin: {{frontendOrigin}}
  Access-Control-Request-Method: GET
  Access-Control-Request-Headers: authorization,content-type,x-requested-with
}

assert {
  res.status: in [200, 204]
  res.headers["access-control-allow-origin"]: in ["{{frontendOrigin}}", "*"]
  res.headers["access-control-allow-credentials"]: eq "true"
}
