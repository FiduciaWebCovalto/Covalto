meta {
  name: POST - /retiro
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/retiro
  body: json
  auth: none
}

headers {
  Origin: {{frontendOrigin}}
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "fretImpRetiro": 15000.0,
  "fretDescripcion": "Retiro de prueba",
  "fretMoneda": 1
}
}

assert {
  res.status: neq 401
  res.status: neq 403
}
