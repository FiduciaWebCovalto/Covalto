meta {
  name: POST - /instcomp
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/instcomp
  body: json
  auth: none
}

headers {
  Origin: {{frontendOrigin}}
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "insNumFolioInst": 1,
  "ficNombreRazonSocial": "Beneficiario Prueba",
  "ficTipoPago": "SPEI",
  "ficReferencia": "REF12345"
}
}

assert {
  res.status: neq 401
  res.status: neq 403
}
