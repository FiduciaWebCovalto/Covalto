# =========================================================================
# .gitignore for Classic Java Web Application (Maven / Java EE / WebLogic)
# =========================================================================

# --- Compiled Java Class files ---
*.class
classes/

# --- Maven Build Artifacts ---
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# --- Package Archives & Deployments ---
*.war
*.ear
*.nar
*.rar
deploy/
build/
dist/

# --- JAR files (Exclude general JARs, but KEEP proprietary vendor JARs and Applets) ---
*.jar
!src/main/webapp/WEB-INF/lib/*.jar
!src/main/webapp/applets/*.jar

# --- Application & Server Runtime Logs ---
*.log
*.log.*
application.log
logs/
servers/
.WL_internal/

# --- Eclipse IDE ---
.project
.classpath
.settings/
.metadata/
bin/
tmp/
*.tmp
*.bak
*.swp
*~.nib
local.properties
.loadpath
.factorypath

# --- IntelliJ IDEA ---
.idea/
*.iml
*.iws
*.ipr
out/

# --- Oracle JDeveloper Legacy Artifacts ---
*.jws
*.jpr
*.cdi
.data/
.wlsjsps/

# --- NetBeans IDE ---
nbproject/private/
nbbuild/
nbproject/genfiles.properties
nbproject/project.xml

# --- Visual Studio Code ---
.vscode/

# --- OS Generated Files ---
Thumbs.db
desktop.ini
.DS_Store
